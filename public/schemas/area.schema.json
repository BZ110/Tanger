{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 512
    },
    "format": {
      "type": "string",
      "const": "tanger.area"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "coordinates": {
      "type": "object",
      "properties": {
        "units": {
          "type": "string",
          "const": "meters"
        },
        "up": {
          "type": "string",
          "const": "Y"
        },
        "handedness": {
          "type": "string",
          "const": "right"
        }
      },
      "required": [
        "units",
        "up",
        "handedness"
      ],
      "additionalProperties": false
    },
    "assets": {
      "maxItems": 4096,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "sectors": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema3"
      }
    },
    "connections": {
      "maxItems": 4096,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema12"
      }
    }
  },
  "required": [
    "format",
    "version",
    "id",
    "coordinates",
    "assets",
    "sectors",
    "connections"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "path": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*\\/)*[A-Za-z0-9][A-Za-z0-9._-]*\\.glb$"
        },
        "provenance": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "original"
                },
                "creator": {
                  "$ref": "#/$defs/__schema2"
                }
              },
              "required": [
                "kind",
                "creator"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "licensed"
                },
                "creator": {
                  "$ref": "#/$defs/__schema2"
                },
                "source": {
                  "type": "string",
                  "maxLength": 2048,
                  "format": "uri"
                },
                "license": {
                  "$ref": "#/$defs/__schema2"
                }
              },
              "required": [
                "kind",
                "creator",
                "source",
                "license"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "path",
        "provenance"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "bounds": {
          "type": "object",
          "properties": {
            "min": {
              "$ref": "#/$defs/__schema4"
            },
            "max": {
              "$ref": "#/$defs/__schema4"
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "instances": {
          "maxItems": 10000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema6"
          }
        },
        "colliders": {
          "maxItems": 10000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema10"
          }
        },
        "anchors": {
          "maxItems": 1024,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema11"
          }
        }
      },
      "required": [
        "id",
        "bounds",
        "instances",
        "colliders",
        "anchors"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/__schema5"
        },
        {
          "$ref": "#/$defs/__schema5"
        },
        {
          "$ref": "#/$defs/__schema5"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "__schema5": {
      "type": "number",
      "minimum": -1000000,
      "maximum": 1000000
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "asset": {
          "$ref": "#/$defs/__schema0"
        },
        "transform": {
          "type": "object",
          "properties": {
            "position": {
              "$ref": "#/$defs/__schema4"
            },
            "rotation": {
              "$ref": "#/$defs/__schema7"
            },
            "scale": {
              "$ref": "#/$defs/__schema8"
            }
          },
          "required": [
            "position",
            "rotation",
            "scale"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "asset",
        "transform"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "__schema8": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/__schema9"
        },
        {
          "$ref": "#/$defs/__schema9"
        },
        {
          "$ref": "#/$defs/__schema9"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "__schema9": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000000
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "position": {
          "$ref": "#/$defs/__schema4"
        },
        "rotation": {
          "$ref": "#/$defs/__schema7"
        },
        "shape": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "box"
                },
                "halfExtents": {
                  "$ref": "#/$defs/__schema8"
                }
              },
              "required": [
                "kind",
                "halfExtents"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "sphere"
                },
                "radius": {
                  "$ref": "#/$defs/__schema9"
                }
              },
              "required": [
                "kind",
                "radius"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "capsule"
                },
                "radius": {
                  "$ref": "#/$defs/__schema9"
                },
                "halfHeight": {
                  "$ref": "#/$defs/__schema9"
                }
              },
              "required": [
                "kind",
                "radius",
                "halfHeight"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "mesh"
                },
                "asset": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "required": [
                "kind",
                "asset"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "position",
        "rotation",
        "shape"
      ],
      "additionalProperties": false
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "position": {
          "$ref": "#/$defs/__schema4"
        }
      },
      "required": [
        "id",
        "position"
      ],
      "additionalProperties": false
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "from": {
          "$ref": "#/$defs/__schema0"
        },
        "to": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "id",
        "from",
        "to"
      ],
      "additionalProperties": false
    }
  },
  "title": "Tanger area manifest v1",
  "description": "Area document structure. Use area:validate for reference, bounds, and quaternion checks."
}
