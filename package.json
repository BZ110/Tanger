{
  "name": "tanger",
  "version": "0.2.0",
  "description": "Tanger — a browser-based open-world RPG",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets:build": "tsx scripts/build-assets.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "area:validate": "tsx scripts/area-tool.ts validate",
    "area:schema": "tsx scripts/area-tool.ts schema",
    "area:schema:check": "tsx scripts/area-tool.ts check-schema",
    "check": "npm run typecheck && npm run lint && npm test && npm run area:schema:check && npm run format:check"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
