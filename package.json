{
  "name": "tanger",
  "version": "0.2.0",
  "description": "Tanger \u2014 a browser-based open-world RPG",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets:build": "tsx scripts/build-assets.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "area:validate": "tsx scripts/area-tool.ts validate",
    "area:schema": "tsx scripts/area-tool.ts schema",
    "area:schema:check": "tsx scripts/area-tool.ts check-schema",
    "check": "npm run typecheck && npm run lint && npm test && npm run area:schema:check && npm run art:schema:check && npm run art:source:check-schema && npm run format:check",
    "art:setup": "python3 tools/art/setup_blender.py",
    "art:doctor": "tsx scripts/art-tool.ts doctor",
    "art:new": "tsx scripts/art-tool.ts new",
    "art:validate": "tsx scripts/art-tool.ts validate",
    "art:export": "tsx scripts/art-tool.ts export",
    "art:render": "tsx scripts/art-tool.ts render",
    "art:inspect": "tsx scripts/art-tool.ts inspect",
    "art:smoke": "tsx scripts/art-tool.ts smoke",
    "art:schema": "tsx scripts/art-tool.ts schema",
    "art:schema:check": "tsx scripts/art-tool.ts check-schema",
    "art:lab": "vite --config tools/art/lab/vite.config.ts --host 127.0.0.1",
    "art:capture": "tsx scripts/art-capture.ts",
    "art:test:e2e": "playwright test --config art.playwright.config.ts",
    "art:lab:build": "vite build --config tools/art/lab/vite.config.ts",
    "art:source:migrate": "tsx scripts/art-source.ts migrate",
    "art:source:prepare": "tsx scripts/art-source.ts prepare",
    "art:source:validate": "tsx scripts/art-source.ts validate",
    "art:source:render": "tsx scripts/art-source.ts render",
    "art:source:assess": "tsx scripts/art-source.ts assess",
    "art:source:advance": "tsx scripts/art-source.ts advance",
    "art:source:gate": "tsx scripts/art-source.ts gate",
    "art:source:edit": "tsx scripts/art-source.ts edit",
    "art:source:derive": "tsx scripts/art-source.ts derive",
    "art:source:compare": "tsx scripts/art-source.ts compare",
    "art:source:schema": "tsx scripts/art-source.ts schema",
    "art:source:check-schema": "tsx scripts/art-source.ts check-schema",
    "art:artist:serve": "tsx scripts/art-artist.ts serve",
    "art:artist": "tsx scripts/art-artist.ts call",
    "art:artist:smoke": "tsx scripts/art-artist-smoke.ts"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
